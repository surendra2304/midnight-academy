# Environment Configuration Template for Midnight Academy

# Supabase Configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# AI Evaluator (Google Gemini)
# Gemini: preferred — comma-separated pool of API keys that auto-rotates on quota (429) or 503/504 errors
GEMINI_API_KEYS=
# Legacy single-key setup (used only when GEMINI_API_KEYS is not set)
GEMINI_API_KEY=
GEMINI_FALLBACK_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Gmail SMTP Email Dispatch (Google App Password)
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=

# Application URL
APP_URL=https://midnight-academy-one.vercel.app
# Optional SMTP overrides — set SMTP_PORT=587 and SMTP_SECURE=false if your
# host blocks outbound SSL on 465 (common on some serverless platforms)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
